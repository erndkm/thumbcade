{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "clearcut",
  "name": "Clearcut",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Drag the pieces, fill a line, cut it clean. Every cut feeds the fuse. Stall and it burns out.",
  "tags": ["puzzle", "blocks", "brain", "arcade"],
  "accentColor": "#A6F23D",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
