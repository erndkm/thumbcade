{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "heatfall",
  "name": "Heatfall",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Spin the grates, drop the ember, dodge the coolant. Stoke five gaps to melt through. The heat is right behind you.",
  "tags": [
    "3d",
    "arcade",
    "reflex",
    "chill"
  ],
  "accentColor": "#FFE14D",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": {
    "vertical": false,
    "horizontal": true,
    "multitouch": false,
    "inputs": [
      "drag"
    ]
  },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": {
    "order": "desc",
    "max": 1000000,
    "format": "integer"
  }
}
