{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "frostwhisk",
  "name": "Frostwhisk",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "moonlit hockey on the frozen pond. drag to whisk the cat's mallet, bank the moonstone in, beat five critters.",
  "tags": ["pixelart", "cozy", "hockey", "sports", "arcade"],
  "accentColor": "#C6E6F5",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 200000, "format": "integer" }
}
