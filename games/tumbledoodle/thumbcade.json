{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "tumbledoodle",
  "name": "Tumbledoodle",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "A hole tore open in my homework and it's hungry. Drag to steer, eat what's smaller, grow, and keep away from the eraser.",
  "tags": ["doodle", "eatandgrow", "drag", "arcade"],
  "accentColor": "#54BF66",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 10000000, "format": "integer" }
}
