{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "pittermoon",
  "name": "Pittermoon",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "the cat's night out ~ tap to pad up a row, swipe to sidestep brooms and pumpkins, outrun the sunrise.",
  "tags": ["pixelart", "cozy", "cat", "arcade", "endless"],
  "accentColor": "#F2B0C0",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": true, "multitouch": false, "inputs": ["tap", "swipe"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": {
    "order": "desc",
    "max": 500000,
    "format": "integer"
  }
}
