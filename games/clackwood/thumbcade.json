{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "clackwood",
  "name": "Clackwood",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Speed pool on a log table in the woods. Drag to aim, pull back, let go. Every pot buys time. The beaver keeps score.",
  "tags": ["pool", "3d", "voxel", "physics", "arcade"],
  "accentColor": "#D2C3F3",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
