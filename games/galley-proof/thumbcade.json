{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "galley-proof",
  "name": "Galley Proof",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "five letters on a galley slip. ringed: right place. underlined: elsewhere. struck: not in it. today's word first.",
  "tags": ["word", "puzzle", "daily", "brain", "calm"],
  "accentColor": "#8F6A2F",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
