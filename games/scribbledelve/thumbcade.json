{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "scribbledelve",
  "name": "Scribbledelve",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "I mapped a dungeon in my maths book. Swipe to run my stick knight, grab every coin, and mind the scribbles. Swords help.",
  "tags": ["doodle", "maze", "chase", "arcade"],
  "accentColor": "#E0A21B",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["swipe"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 10000000, "format": "integer" }
}
