{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "flapjack",
  "name": "Flapjack",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "A pancake with ambition. Tap to flip through the forks of a midnight diner. Butter is optional.",
  "tags": ["onetap", "flyer", "arcade", "reflex"],
  "accentColor": "#FFB23F",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 100000, "format": "integer" }
}
