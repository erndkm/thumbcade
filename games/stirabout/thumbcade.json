{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "stirabout",
  "name": "Stirabout",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "slide the cauldron, catch what the recipe asks for, dodge the rest. the cat is not helping.",
  "tags": [
    "pixelart",
    "cozy",
    "catch",
    "witch"
  ],
  "accentColor": "#E8893C",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": {
    "vertical": false,
    "horizontal": true,
    "multitouch": false,
    "inputs": [
      "drag"
    ]
  },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": {
    "order": "desc",
    "max": 100000,
    "format": "integer"
  }
}
