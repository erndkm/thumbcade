{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "voltbrick",
  "name": "Voltbrick",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Drag anywhere to steer. Split the ball, grab the beam, clear the grid. The bricks had it coming.",
  "tags": ["bricks", "arcade", "powerups", "retro"],
  "accentColor": "#4D8DFF",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
