{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "platterbang",
  "name": "Platterbang",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "PULL THE PEGS, FILL THE JARS, WATCH THE DISHES SWING, DROP AND SMASH! CLEAR THE WALL BEFORE CLOSING TIME!",
  "tags": ["puzzle", "sorting", "physics", "cartoon", "speed"],
  "accentColor": "#14A87D",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
