{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "leapwater",
  "name": "Leapwater",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "hold to dive, let go to leap. one koi, a long stream, and falls that climb on into the night.",
  "tags": ["onetap", "physics", "koi", "endless", "chill"],
  "accentColor": "#FF48B0",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["hold"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 100000, "format": "integer", "unit": "m" }
}
