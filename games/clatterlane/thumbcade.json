{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "clatterlane",
  "name": "Clatterlane",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Glow bowling against the clock. Flick to bowl, curve it to hook, and every strike buys you time.",
  "tags": ["bowling", "3d", "flick", "physics", "arcade"],
  "accentColor": "#08A0F0",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["swipe"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
