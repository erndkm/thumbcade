{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "laddersnap",
  "name": "Laddersnap",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "One up, one down. Snap cards onto the pile, chain them without drawing and beat the clock hand after hand.",
  "tags": ["cards", "solitaire", "puzzle", "arcade"],
  "accentColor": "#7A86FF",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
