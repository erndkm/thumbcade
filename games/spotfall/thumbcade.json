{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "spotfall",
  "name": "Spotfall",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "drag to aim, let go to shoot. pop three of an ink, and every dot left hanging falls off the print.",
  "tags": ["puzzle", "aim", "match3", "riso"],
  "accentColor": "#00873A",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag", "tap"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
