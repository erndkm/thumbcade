{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "neon-chop",
  "name": "Neon Chop",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "The Glow Market is open late. Swipe through neon produce, chain combos, and never, ever cut the static.",
  "tags": ["slash", "reflex", "arcade", "neon"],
  "accentColor": "#FF3D6E",
  "icon": "assets/icon.png",
  "ageRating": "9+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 100000, "format": "integer" }
}
