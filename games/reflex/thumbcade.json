{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "reflex",
  "name": "Reflex",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Four tiny tests, one thumb, three lives. Wait for it, spot the odd one, read the ink. Fast.",
  "tags": ["reflex", "reaction", "brain", "speed"],
  "accentColor": "#00E5C7",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
