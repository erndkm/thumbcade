{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "long-suit",
  "name": "Long Suit",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "patience against the clock. red on black, one lower; turn up what's hidden and send every suit home, ace first.",
  "tags": ["cards", "solitaire", "puzzle", "brain", "calm"],
