{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "six-seven",
  "name": "Six Seven",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Tap left for six, right for seven. Keep the hype up and freeze when the teacher looks.",
  "tags": ["tapping", "speed", "funny", "meme", "arcade"],
  "accentColor": "#8C6CFF",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": true, "inputs": ["tap"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 100000, "format": "integer" }
}
