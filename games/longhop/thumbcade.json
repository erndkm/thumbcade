{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "longhop",
  "name": "Longhop",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "hold as you land, let go at the bottom of the squat. one kangaroo, one joey, one very long horizon.",
  "tags": ["onetap", "physics", "timing", "runner", "endless"],
