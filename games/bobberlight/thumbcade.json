{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "bobberlight",
  "name": "Bobberlight",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "night fishing with my witch's cat. cast by the moon, wait for the dip, reel gently. dawn ends the night.",
  "tags": [
    "pixelart",
    "cozy",
    "fishing",
    "timing"
  ],
  "accentColor": "#8CC7B8",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": {
    "vertical": false,
    "horizontal": false,
    "multitouch": false,
    "inputs": [
      "tap"
    ]
  },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": {
    "order": "desc",
    "max": 200000,
    "format": "integer",
    "unit": "g"
  }
}
