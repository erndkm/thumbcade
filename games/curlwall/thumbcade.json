{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "curlwall",
  "name": "Curlwall",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Free kicks under the floodlights. Flick to shoot, bow your swipe to bend it round the wall. Corners pay.",
  "tags": ["football", "3d", "flick", "arcade"],
  "accentColor": "#E4FF3A",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["swipe"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
