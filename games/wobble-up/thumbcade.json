{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "wobble-up",
  "name": "Wobble Up",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "ONE JELLY, ALL BOING! DRAG TO STEER, SPROING OFF SPRINGS, MUNCH CHERRIES AND DO NOT HUG THE URCHINS!",
  "tags": [
    "jumper",
    "cartoon",
    "arcade",
    "physics"
  ],
  "accentColor": "#FF7CC6",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": {
    "vertical": false,
    "horizontal": true,
    "multitouch": false,
    "inputs": [
      "drag"
    ]
  },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": {
    "order": "desc",
    "max": 100000,
    "format": "integer"
  }
}
