{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "rimflare",
  "name": "Rimflare",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Rooftop hoops after dark. Flick to shoot, swish to buy time, sink three in a row and the ball catches fire.",
  "tags": ["basketball", "3d", "flick", "arcade"],
  "accentColor": "#EC1380",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["swipe"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
