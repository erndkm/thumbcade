{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "pinchbake",
  "name": "Pinchbake",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "We sculpted nine bakes out of clay. Pinch one, drop it, squish twins together, and keep the dough from rising over.",
  "tags": ["merge", "physics", "claymation", "puzzle"],
  "accentColor": "#E86F87",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": {
    "vertical": true,
    "horizontal": true,
    "multitouch": false,
    "inputs": ["drag", "tap"]
  },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": {
    "order": "desc",
    "max": 1000000,
    "format": "integer"
  }
}
