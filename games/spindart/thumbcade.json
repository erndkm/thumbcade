{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "spindart",
  "name": "Spindart",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Tap to fire darts into a spinning arcade target. Fill the rim, burst the disc. Never hit steel.",
  "tags": ["3d", "onetap", "arcade", "reflex"],
  "accentColor": "#EE55FF",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 100000, "format": "integer" }
}
