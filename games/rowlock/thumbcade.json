{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "rowlock",
  "name": "Rowlock",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Every row, column and box takes each digit once. Fill a grid, lock it shut, beat the clock to the next one.",
  "tags": ["puzzle", "numbers", "logic", "brain"],
  "accentColor": "#C6AA39",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
