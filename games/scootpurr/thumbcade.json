{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "scootpurr",
  "name": "Scootpurr",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "long cats nap all over the rug ~ tap one whose way is clear and off it scoots. clear the rug before the candle goes.",
  "tags": ["pixelart", "cozy", "cat", "puzzle", "brain"],
  "accentColor": "#9B5F7C",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
