{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "squishputt",
  "name": "Squishputt",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "We squished tiny golf holes out of clay. Pull back, let go, sink it. Aces buy you more strokes.",
  "tags": ["minigolf", "3d", "claymation", "chill", "physics"],
  "accentColor": "#F2A08A",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": {
    "vertical": true,
    "horizontal": true,
    "multitouch": false,
    "inputs": ["drag"]
  },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": {
    "order": "desc",
    "max": 50000,
    "format": "integer"
  }
}
