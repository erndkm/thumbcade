{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "weavefire",
  "name": "Weavefire",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Drag to weave. Your guns never stop. Skim the bullets for sparks, chain the kills, and break the Loom.",
  "tags": ["shooter", "arcade", "neon", "reflex"],
  "accentColor": "#38FFD0",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 10000000, "format": "integer" }
}
