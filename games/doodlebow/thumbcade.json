{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "doodlebow",
  "name": "Doodlebow",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "I drew a tiny archer in my notebook and now he wants targets. Pull back, let go, pop the balloons. Hits refund arrows.",
  "tags": ["archery", "doodle", "aim", "physics"],
  "accentColor": "#2747B5",
  "icon": "assets/icon.png",
  "ageRating": "4+",
  "controls": { "vertical": true, "horizontal": true, "multitouch": false, "inputs": ["drag"] },
  "session": "medium",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 1000000, "format": "integer" }
}
