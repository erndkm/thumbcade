# Copy to supabase/functions/.env for local development (loaded by
# `supabase functions serve --env-file supabase/functions/.env`). Production: `supabase secrets set`.
SESSION_SIGNING_SECRET=local-dev-session-signing-secret-change-me
GAME_HOST_BASE=http://127.0.0.1:5555
PORTAL_URL=http://localhost:3000
# Comma-separated origins allowed to call the functions from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://thumbcade.com
# Optional Expo access token (push security). Leave empty locally.
EXPO_ACCESS_TOKEN=
# Public base URL used when writing storage URLs (the runtime SUPABASE_URL is the internal one).
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
