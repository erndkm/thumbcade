{
  "name": "@thumbcade/portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "predev": "node scripts/copy-brand.mjs",
    "prebuild": "node scripts/copy-brand.mjs && pnpm run notices",
    "notices": "node ../../scripts/licenses/collect.ts . src/lib/notices.generated.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@thumbcade/design-tokens": "workspace:*",
    "@thumbcade/legal": "workspace:*",
    "@thumbcade/protocol": "workspace:*",
    "@thumbcade/swipe-contract": "workspace:*",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3"
  }
}
