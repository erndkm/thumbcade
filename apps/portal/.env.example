# Copy to .env.local. Local values come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: admin review actions and the CLI device-code routes.
SUPABASE_SERVICE_ROLE_KEY=
# Where game bundles are served: the local game host, or subdomain:thumbcade.gg in production (one origin per game).
# The portal only lets its pages frame this host (Content-Security-Policy frame-src).
NEXT_PUBLIC_GAME_HOST=http://127.0.0.1:5555
# Public origin of this site (share links, Open Graph URLs, auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Store listings for the download section and the /get QR redirect. Leave empty until the apps are live ("Coming soon").
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
