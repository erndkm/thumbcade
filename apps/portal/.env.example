# Copy to .env.local. Local values come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: admin review actions and the CLI device-code routes.
SUPABASE_SERVICE_ROLE_KEY=
# Where game bundles are served: the local game host, or https://thumbcade.gg in production.
NEXT_PUBLIC_GAME_HOST=http://127.0.0.1:5555
# Public origin of this site (share links, Open Graph URLs, auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
