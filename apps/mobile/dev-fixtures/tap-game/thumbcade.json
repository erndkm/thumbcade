{
  "$schema": "https://thumbcade.com/schema/manifest-v1.json",
  "id": "fixture-tap",
  "name": "Pulse Ring",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "entry": "index.html",
  "description": "Tap when the pulse kisses the ring. Perfect hits stack your combo. Three misses and you're out.",
  "tags": ["reflex", "onetap", "rhythm"],
  "accentColor": "#3DFFB0",
  "icon": "assets/icon.png",
  "poster": "assets/poster.jpg",
  "ageRating": "4+",
  "controls": { "vertical": false, "horizontal": false, "multitouch": false, "inputs": ["tap"] },
  "session": "short",
  "audio": true,
  "orientation": "portrait",
  "score": { "order": "desc", "max": 100000, "format": "integer" }
}
