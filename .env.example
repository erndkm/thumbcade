# Copy to .env.local (portal, scripts) and apps/mobile/.env (mobile). Values below are the
# well-known LOCAL Supabase defaults printed by `supabase status` — never production secrets.

# --- Supabase (local) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Service role: read it from `supabase status -o env` (SERVICE_ROLE_KEY). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mobile (Expo; EXPO_PUBLIC_* are bundled into the app) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Path-mode game host for local dev. Android emulator: use http://10.0.2.2:5555
EXPO_PUBLIC_GAME_HOST=http://127.0.0.1:5555
EXPO_PUBLIC_SHARE_BASE=http://localhost:3000
# Social sign-in buttons only render when the provider is configured (see docs/GAPS.md).
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Portal (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_GAME_HOST=http://localhost:5555
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Edge functions: see supabase/functions/.env.example (copied to supabase/functions/.env) ---
# Served with `supabase functions serve --env-file supabase/functions/.env` (pnpm dev does this).
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# HMAC secret for play-session tokens.
SESSION_SIGNING_SECRET=change-me-local-only
# Public base URLs used in responses.
GAME_HOST_BASE=http://127.0.0.1:5555
PORTAL_URL=http://localhost:3000

# --- Game host (services/game-host) ---
GAME_HOST_PORT=5555

# --- Reviewer (services/reviewer) ---
REVIEWER_POLL_MS=2000
